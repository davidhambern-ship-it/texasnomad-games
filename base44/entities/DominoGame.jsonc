{
  "name": "DominoGame",
  "type": "object",
  "properties": {
    "room_code": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "active",
        "finished"
      ],
      "default": "waiting"
    },
    "phase": {
      "type": "string",
      "enum": [
        "waiting",
        "playing",
        "round_over",
        "game_over"
      ],
      "default": "waiting"
    },
    "players": {
      "type": "array",
      "description": "4 player slots ordered by seat (0-3). Seats 0&2 = Team A, Seats 1&3 = Team B.",
      "items": {
        "type": "object",
        "properties": {
          "seat": {
            "type": "number"
          },
          "playerId": {
            "type": "string"
          },
          "playerName": {
            "type": "string"
          },
          "hand": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "isAI": {
            "type": "boolean",
            "default": false
          },
          "connected": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "board": {
      "type": "array",
      "description": "Plays in order: { id, a, b, side: first|left|right|up|down, inner, outer, seat, n }. Positions are computed by layoutBoard() and never stored.",
      "items": {
        "type": "object"
      }
    },
    "boneyard": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "currentSeat": {
      "type": "number",
      "default": 0
    },
    "roundNumber": {
      "type": "number",
      "default": 1
    },
    "teamScores": {
      "type": "object",
      "description": "{ teamA: number, teamB: number }"
    },
    "roundWinner": {
      "type": "object",
      "description": "{ team, points, playerName, winnerSeat, reason: domino|blocked|score, teamPips }"
    },
    "scoreLimit": {
      "type": "number",
      "default": 150
    },
    "leadTile": {
      "type": "string",
      "description": "Tile that must open the round (the 6-6 in round 1), null otherwise"
    },
    "passes": {
      "type": "number",
      "default": 0,
      "description": "Knocks in a row; 4 = blocked round"
    },
    "lastPlay": {
      "type": "object",
      "description": "{ seat, id, side, points, count, n } or { seat, pass: true, n } — drives sounds and score pop-ups"
    },
    "activityLog": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_by_user_id": {
      "type": "string"
    }
  },
  "required": [
    "room_code"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": null,
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}