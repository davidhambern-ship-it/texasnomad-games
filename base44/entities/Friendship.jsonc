{
  "name": "Friendship",
  "type": "object",
  "properties": {
    "requester_user_id": {
      "type": "string",
      "description": "User ID who sent the friend request"
    },
    "recipient_user_id": {
      "type": "string",
      "description": "User ID who received the friend request"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined"
      ],
      "default": "pending"
    },
    "requester_username": {
      "type": "string",
      "description": "Cached username of requester"
    },
    "recipient_username": {
      "type": "string",
      "description": "Cached username of recipient"
    }
  },
  "required": [
    "requester_user_id",
    "recipient_user_id"
  ],
  "rls": {
    "create": {
      "data.requester_user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.requester_user_id": "{{user.id}}"
        },
        {
          "data.recipient_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.requester_user_id": "{{user.id}}"
        },
        {
          "data.recipient_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.requester_user_id": "{{user.id}}"
        },
        {
          "data.recipient_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}