# Copy to .env.local for local development. Never commit real secrets.
# Use a dedicated Neon branch and least-privilege role for previews.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full

# Required to issue and verify short-lived guest identities.
# Generate a unique random value of at least 32 bytes for each environment.
TNG_GUEST_TOKEN_SECRET=REPLACE_WITH_A_RANDOM_SECRET

# Environment-specific legacy API and Neon Auth origins.
# IMPORTANT: set both explicitly in Preview; do not let Preview fall back to production.
TNG_API_ORIGIN=https://YOUR_ENVIRONMENT_API_HOST
NEON_AUTH_ORIGIN=https://YOUR_ENVIRONMENT_AUTH_HOST/tng/auth

# Shared room relay used by VIRAL and Rodeo Rumble on Vercel.
# Use the Cloudflare Worker URL and a unique high-entropy secret per environment.
TNG_ROOM_COORDINATOR_URL=wss://YOUR_ROOM_COORDINATOR.workers.dev
TNG_ROOM_COORDINATOR_SECRET=REPLACE_WITH_A_RANDOM_SECRET

# Optional: comma-separated additional browser origins.
# VERCEL_URL and VERCEL_BRANCH_URL are also checked automatically on Vercel.
# TNG_LIVE_ALLOWED_ORIGINS=https://texasnomadgames.com,https://www.texasnomadgames.com
