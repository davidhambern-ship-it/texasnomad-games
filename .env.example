# Browser feature flags. Base44 function calls are disabled unless explicitly
# re-enabled during the migration.
VITE_ENABLE_BASE44_FUNCTIONS=false
VITE_TNG_BACKEND_ENABLED=false

# Public development Auth endpoint. Each Neon branch has a different URL.
VITE_NEON_AUTH_URL=https://YOUR-ENDPOINT.neonauth.REGION.aws.neon.tech/tng/auth

# Use the pooled Neon URL for application requests.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DATABASE?sslmode=require

# Use the direct Neon URL only for Drizzle migrations.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require

# JWT verification for Managed Better Auth. Issuer and audience are the Auth
# URL origin only (scheme + hostname), not the full /tng/auth path.
TNG_AUTH_JWKS_URL=https://AUTH_PROVIDER/.well-known/jwks.json
TNG_AUTH_ISSUER=https://AUTH_PROVIDER
TNG_AUTH_AUDIENCE=https://AUTH_PROVIDER

# At least 32 random bytes. Used to hash one-time display pairing codes.
TNG_PAIRING_SECRET=replace-with-a-long-random-secret
